[binaries]
c = '/usr/bin/arm-none-eabi-gcc'
cpp = '/usr/bin/arm-none-eabi-g++'
ar = '/usr/bin/arm-none-eabi-ar'
strip = '/usr/bin/arm-none-eabi-strip'
objcopy = '/usr/bin/arm-none-eabi-objcopy'

[properties]
variant = 'stm32h755xx'
linker_script_name = 'STM32H755ZU_FLASH.ld'

[built-in options]

c_args = [
  '-DSTM32H755xx',
#  '--include=stm32h755.h',
  ]

cpp_args = [
  '-DSTM32H755xx',
#  '--include=stm32h755.h',
  ]

c_link_args = ['-Wl,--gc-sections', ]
cpp_link_args = ['-Wl,--gc-sections', ]

[host_machine]
system = 'bare'
cpu_family = 'arm'
cpu = 'cortex-m7'
endian = 'little'

