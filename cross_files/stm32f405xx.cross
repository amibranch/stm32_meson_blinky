[binaries]
c = '/usr/bin/arm-none-eabi-gcc'
cpp = '/usr/bin/arm-none-eabi-g++'
ar = '/usr/bin/arm-none-eabi-ar'
strip = '/usr/bin/arm-none-eabi-strip'
objcopy = '/usr/bin/arm-none-eabi-objcopy'

[properties]
variant = 'stm32f405xx'
linker_script_name = 'stm32f40xx_flash.ld'

[built-in options]

c_args = [
  '-DSTM32F405xx',
#  '-DWEACTV30',
  ]

cpp_args = [
  '-DSTM32F405xx',
#  '-DWEACTV30',
  ]

c_link_args = ['-Wl,--gc-sections', ]
cpp_link_args = ['-Wl,--gc-sections', ]

[host_machine]
system = 'bare'
cpu_family = 'arm'
cpu = 'cortex-m4'
endian = 'little'
